# OS cruft
.DS_Store
Thumbs.db

# Personal, cross-project Claude Code config - not part of this product
.hs.json
.mcp.json
plans/
docs/
AGENTS.md
CLAUDE.md

# Python virtualenvs and bytecode caches (tts-sidecar/ + spikes/)
**/.pyenv-tts*/
**/__pycache__/
*.pyc

# Filler audio is rendered by `task dev`/`task setup` (assets/fillers/generate_fillers.py),
# never committed — only the generator script and its source phrases are source-controlled.
assets/fillers/*.wav

# Node build output / install artifacts
node_modules/
out/

# Runtime data (SQLite DB, room artifacts) - regenerated, never shipped
data/
*.log

# Pre-migration DB snapshots (VACUUM INTO output), written next to the live DB file
*.bak
*.bak-wal
*.bak-shm

# Local environment overrides - never commit real values, only env.example
.env
.env.local
.env.*.local

# runtimes/.claude is this product's own skill/hook config
!runtimes/.claude/
!runtimes/.claude/**
