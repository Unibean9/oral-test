# Copy to .env. Only variables that commonly need a non-default value are here —
# everything else already has a sensible default in code (see src/server.ts,
# src/db/connection.ts, src/claude-cli/spawn.ts) and doesn't need to be set
# unless you're doing something non-standard.

# Origins allowed to call this API cross-origin (comma-separated, exact match).
# Change this whenever the FE runs on a port other than the defaults below.
BRAINSTORM_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Secret used to sign teacher session JWTs. Falls back to an insecure dev-only
# default (with a startup warning) if unset — always set this before any
# non-local deployment.
ORAL_TEST_JWT_SECRET=change-me-before-deploying

# Network binding and the Host values this API accepts. Keep the defaults for local development.
# Docker Compose sets ORAL_TEST_HOST=0.0.0.0 internally while its published port remains bound to
# the VPS loopback address. Add your reverse proxy's public host (e.g. exam.example.edu) here.
ORAL_TEST_HOST=127.0.0.1
ORAL_TEST_ALLOWED_HOSTS=127.0.0.1:3001,localhost:3001,[::1]:3001,127.0.0.1,localhost,[::1]

# Base URL of the tts-sidecar process (tts-sidecar/README.md). Only needs to change if the
# sidecar runs on a different port or host than its own default.
TTS_SIDECAR_URL=http://127.0.0.1:8765

# No setup needed for the Claude CLI in normal local dev: spawned examiner/reviewer children use
# this machine's own `claude` login by default (whatever `claude login` already set up). Run
# `npm run check:claude-cli` to verify the CLI is installed, authenticated, and reachable.
#
# Only set ANTHROPIC_API_KEY / CLAUDE_CODE_OAUTH_TOKEN below if you want an explicit override
# instead of the local `claude login` session (e.g. a headless server with no interactive login).
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=

# Isolated home directory for spawned `claude` children — leave unset for local dev. Only set this
# for a real multi-tenant/shared deployment where the operator's personal ~/.claude (skills,
# settings, session history) must not be reachable from a spawned examiner/reviewer; you would then
# also need `CLAUDE_CONFIG_DIR=<this path> claude login` once, or the two vars above.
ORAL_RUNTIME_HOME=

# Host-side port docker-compose.yml publishes the backend on (127.0.0.1 only).
ORAL_TEST_PORT=3001
