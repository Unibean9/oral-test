# Copy to .env. Only variables that commonly need a non-default value are here —
# everything else already has a sensible default in code (see src/server.ts,
# src/db/connection.ts, src/claude-cli/spawn.ts, src/tts/streamClient.ts) and
# doesn't need to be set unless you're doing something non-standard.

# Origins allowed to call this API cross-origin (comma-separated, exact match).
# Change this whenever the FE runs on a port other than the defaults below.
BRAINSTORM_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Cloud sync (Firebase Storage mirror) — optional. Leave both unset to keep it
# disabled; every other feature works untouched. Set both to enable it.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
